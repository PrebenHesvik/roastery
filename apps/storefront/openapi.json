              "EUR"
            ],
            "title": "Currency",
            "type": "string"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "display_gross": {
            "$ref": "#/components/schemas/Amount"
          },
          "gross": {
            "$ref": "#/components/schemas/Amount"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/QuotedLine"
