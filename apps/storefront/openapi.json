  },
  "info": {
    "summary": "The shop over HTTP: the catalogue, a quote, guest checkout, a test payment.",
    "title": "Sydvest Kaffebrenneri",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/checkout": {
      "post": {
        "description": "A guest's order. 409 `PriceChanged` (with the new quote), `OutOfStock` or\n`KeyReused`; nothing is written on a refusal.",
        "operationId": "checkout",
        "parameters": [
          {
            "description": "One key per attempt: the same key and body give the same reply.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "One key per attempt: the same key and body give the same reply.",
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacedOrder"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Place Order"
      }
    },
    "/orders/{token}": {
      "get": {
        "description": "The order its private link names; 404 `UnknownToken`.",
        "operationId": "getOrder",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get Order"
      }
    },
    "/products": {
      "get": {
        "description": "Every product, priced on Norway's day; also in the country's currency.",
        "operationId": "listProducts",
        "parameters": [
          {
            "description": "The buyer's country: its currency and VAT wording.",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "default": "NO",
              "description": "The buyer's country: its currency and VAT wording.",
              "enum": [
                "DK",
                "FI",
                "NO",
                "SE"
              ],
              "title": "Country",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
