              "EUR"
            ],
            "title": "Currency",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BeanDetails"
              },
              {
                "$ref": "#/components/schemas/EquipmentDetails"
              }
            ],
            "title": "Details"
          },
          "display_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "in_stock": {
            "title": "In Stock",
            "type": "boolean"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "price_label": {
            "enum": [
              "incl_vat",
              "no_norwegian_vat"
            ],
            "title": "Price Label",
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/ProductInfo"
          },
          "unit_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
