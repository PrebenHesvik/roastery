      "SandboxPaymentRequest": {
        "description": "A test payment of the order the token links to. No amount: the order's is paid.",
        "properties": {
          "outcome": {
            "enum": [
              "approve",
              "decline",
              "outage"
            ],
            "title": "Outcome",
            "type": "string"
