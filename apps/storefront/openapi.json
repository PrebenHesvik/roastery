        "title": "Order",
        "type": "object"
      },
      "OrderLine": {
        "properties": {
          "display_unit_price": {
            "$ref": "#/components/schemas/Amount"
          },
          "line_id": {
            "title": "Line Id",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "qty": {
            "title": "Qty",
            "type": "integer"
          },
          "unit_price": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "line_id",
          "product_id",
          "qty",
          "unit_price",
          "display_unit_price"
        ],
        "title": "OrderLine",
        "type": "object"
      },
      "PlacedOrder": {
        "description": "The order placed; `token` is its private link.",
        "properties": {
          "country": {
            "enum": [
              "DK",
              "FI",
              "NO",
              "SE"
            ],
            "title": "Country",
            "type": "string"
          },
          "currency": {
            "enum": [
              "NOK",
              "SEK",
              "DKK",
              "EUR"
            ],
            "title": "Currency",
            "type": "string"
          },
          "display_total": {
            "$ref": "#/components/schemas/Amount"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "order_id",
          "country",
          "total",
          "token",
          "currency",
          "display_total"
        ],
        "title": "PlacedOrder",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "An error, as RFC 9457's problem+json. Switch on `code`, never on `title`.",
        "properties": {
          "code": {
            "examples": [
              "OutOfStock"
            ],
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProductInfo": {
        "properties": {
          "category_id": {
