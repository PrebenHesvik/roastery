            "title": "Lines",
            "type": "array"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "placed",
              "paid",
              "invoiced",
              "shipped",
              "delivered",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "order_id",
          "status",
          "country",
          "day",
          "lines",
          "total",
          "currency",
          "display_total"
