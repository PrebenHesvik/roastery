{
  "components": {
    "schemas": {
      "Amount": {
        "description": "Money: the amount as text with its decimals, and the currency.",
        "properties": {
          "amount": {
            "examples": [
              "129.00"
            ],
            "maxLength": 32,
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "examples": [
              "NOK"
            ],
            "maxLength": 3,
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Amount",
        "type": "object"
      },
      "BeanDetails": {
        "properties": {
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "process": {
            "title": "Process",
            "type": "string"
          },
          "roast": {
            "title": "Roast",
            "type": "string"
          },
          "weight_g": {
            "title": "Weight G",
            "type": "integer"
          }
        },
        "required": [
          "weight_g",
          "origin",
          "roast",
          "process"
        ],
        "title": "BeanDetails",
        "type": "object"
      },
      "CartItem": {
        "description": "A cart's line: a product and a quantity. No price: the server prices it.",
        "properties": {
          "product_id": {
            "examples": [
              "P-10"
            ],
            "maxLength": 32,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          },
          "qty": {
            "examples": [
              2
            ],
            "maximum": 999.0,
            "minimum": 1.0,
            "title": "Qty",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "qty"
        ],
        "title": "CartItem",
        "type": "object"
      },
      "CheckoutRequest": {
        "description": "A guest's order: the cart, the total the buyer confirmed (NOK), and the contact.",
        "properties": {
          "city": {
            "maxLength": 100,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "country": {
            "enum": [
              "DK",
              "FI",
              "NO",
              "SE"
            ],
            "title": "Country",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "postal_code": {
            "examples": [
              "5003"
            ],
            "maxLength": 12,
            "minLength": 1,
            "title": "Postal Code",
            "type": "string"
          },
          "street": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Street",
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "country",
          "items",
          "total",
          "name",
          "email",
          "street",
          "postal_code",
          "city"
        ],
        "title": "CheckoutRequest",
        "type": "object"
      },
      "EquipmentDetails": {
        "properties": {
          "material": {
            "title": "Material",
            "type": "string"
          },
          "warranty_months": {
            "title": "Warranty Months",
            "type": "integer"
          }
        },
        "required": [
          "warranty_months",
          "material"
        ],
        "title": "EquipmentDetails",
        "type": "object"
      },
      "ListedProduct": {
        "description": "A product on Norway's day. No price (`unit_price` null): coming soon.",
        "properties": {
          "details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BeanDetails"
              },
              {
                "$ref": "#/components/schemas/EquipmentDetails"
              }
            ],
            "title": "Details"
          },
          "display_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "in_stock": {
            "title": "In Stock",
            "type": "boolean"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "product": {
            "$ref": "#/components/schemas/ProductInfo"
          },
          "unit_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "product",
          "details",
          "unit_price",
          "percent",
          "in_stock",
          "display_price"
        ],
        "title": "ListedProduct",
        "type": "object"
      },
      "Order": {
        "properties": {
          "country": {
            "enum": [
              "DK",
              "FI",
              "NO",
              "SE"
            ],
            "title": "Country",
            "type": "string"
          },
          "currency": {
            "enum": [
              "NOK",
              "SEK",
              "DKK",
              "EUR"
            ],
            "title": "Currency",
            "type": "string"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "display_total": {
            "$ref": "#/components/schemas/Amount"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
